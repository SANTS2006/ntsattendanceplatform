# ─────────────────────────────────────────────────────────────────────────────
# NTSAttend backend configuration. Copy to backend/.env and fill in the values.
# NEVER commit real secrets. On Render, these are entered when you create the Blueprint (service "ntsattend").
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | production (tests set "test" themselves)
PORT=4000                       # Render sets this automatically
APP_URL=http://localhost:5173   # public URL of the app (QR codes, email links)
# CORS_ORIGINS=                 # only if the web app is served from a different origin
# TRUST_PROXY=1                 # number of reverse proxies in front (Render: 1)

# ── Neon PostgreSQL ── copy both from Neon → Connect (same role, e.g. neondb_owner)
# DATABASE_URL: "Connection pooling" ON  (host contains -pooler) — used by the app.
# DIRECT_URL:   "Connection pooling" OFF (direct host)          — used by migrations.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Secrets (required) ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=              # ≥32 chars — signs staff access tokens
JWT_PUBLIC_SECRET=              # ≥32 chars — signs anonymous attendance tokens
DATA_ENCRYPTION_KEY=            # 32 random bytes, base64 — encrypts MFA secrets
HASH_PEPPER=                    # ≥16 chars — keyed hashing (IP abuse detection, signed links)

# ── Cloudinary (all uploaded files: selfies, logos, avatars, imports, reports) ──
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Brevo (transactional email) ─────────────────────────────────────────────
BREVO_API_KEY=                  # Brevo → SMTP & API → API keys
MAIL_FROM=NTSAttend <no-reply@your-domain.com>   # must be a verified Brevo sender

# ── Cloudflare R2 (database backups) — set all four, or leave all empty to disable ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# ── Redis — required in production (e.g. a free Redis Cloud database). Empty in development = in-process jobs ──
REDIS_URL=
WORKERS_IN_API=true             # run background jobs inside the API (one service); false when a separate worker runs

# ── Links inside emails (defaults to APP_URL). Set to the hosted site so emails sent from a
#    development machine still open https://ntsattend.onrender.com instead of localhost.
EMAIL_BASE_URL=https://ntsattend.onrender.com

# ── Optional ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=               # "Continue with Google" (OAuth Web client id)
LOG_LEVEL=info

# ── Automated tests (a separate Neon branch/database, never production) ──────
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# ── Demo data (`npm run db:seed`, development only) ─────────────────────────
SEED_PASSWORD=
SEED_ADMIN_EMAIL=admin@nts.localhost
SEED_OWNER_EMAIL=owner@demo.localhost
SEED_LECTURER_EMAIL=lecturer@demo.localhost
