# Frontend (Vite) configuration. Only VITE_* variables are exposed to the browser — never put secrets here.
# API base path. In development the Vite proxy forwards /api to the backend, so the default is fine.
VITE_API_BASE_URL=/api/v1
# Backend origin used by the Vite dev proxy
VITE_DEV_API_PROXY=http://localhost:4000
