{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "backend"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "api-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:sandbox",
        "--workspace",
        "backend"
      ],
      "port": 4000
    }
  ]
}
